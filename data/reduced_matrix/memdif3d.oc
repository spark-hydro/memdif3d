# memdif3d input written by xlsx2memdif.py from Reduced_Matrix.xlsx
# {period} in a file name is replaced by the period (day) number.
BEGIN options
  DAILY_FIELD   FILEOUT field_{period}.csv
  PROBES        FILEOUT probes_{period}.csv
  RESTART       FILEOUT restart.dat
END options

# written every time step: the source cell, then cells at the middle of the source footprint
BEGIN probes
  SOURCE
  1 22 15
  6 22 15
END probes
