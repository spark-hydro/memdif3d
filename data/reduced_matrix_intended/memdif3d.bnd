# memdif3d input written by xlsx2memdif.py from Reduced_Matrix.xlsx
# Intended pattern (the two spreadsheet irregularities removed, see tools/make_intended_set.py).
# memdif3d boundary: five side rules, per-cell exceptions, neighbour overrides.
# Boundary cells are the IDOMAIN = 2 cells. The rules are evaluated in this order, a cell on two sides takes
# the later rule and COPY reads the new value of the cell one step inward; then the exceptions, in file order.
#   COPY factor | FIXED value | NOFLOW (= COPY 1.0).   Cell ids: ilay irow icol.
BEGIN boundary
  IROW=1 COPY 0.82
  IROW=NROW COPY 0.82
  ICOL=NCOL COPY 0.82
  ILAY=1 COPY 0.82
  ILAY=NLAY COPY 0.82
END boundary

BEGIN boundary_cells
END boundary_cells

# Neighbour overrides replace the default neighbour of a fluid cell in one direction.
#   default: the 6 face neighbours that are not solid; ICOL = 1 under a source face looks at the source.
BEGIN neighbor_overrides
END neighbor_overrides
